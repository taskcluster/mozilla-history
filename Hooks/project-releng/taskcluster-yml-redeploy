{
  "bindings": [
    {
      "exchange": "exchange/taskcluster-github/v1/taskcluster-yml-update",
      "routingKeyPattern": "#"
    }
  ],
  "hookGroupId": "project-releng",
  "hookId": "taskcluster-yml-redeploy",
  "metadata": {
    "description": "*DO NOT EDIT* - This resource is configured automatically by [ci-admin](https://github.com/mozilla-releng/fxci-config).\n\nRedeploy fxci-config when a repository it manages changes its `.taskcluster.yml`, so that the in-tree action hooks generated from that file stop being stale.",
    "emailOnError": true,
    "name": "taskcluster.yml redeploy",
    "owner": "release+hooks@mozilla.com"
  },
  "schedule": [],
  "task": {
    "scopes": [
      "auth:github-repo-token:action/mozilla-releng/fxci-config:actions:write"
    ],
    "created": {
      "$fromNow": "0 seconds"
    },
    "expires": {
      "$fromNow": "1 month"
    },
    "payload": {
      "env": {
        "REF": {
          "$eval": "payload.ref"
        },
        "EVENT_ID": {
          "$eval": "payload.eventId"
        },
        "REPOSITORY": {
          "$eval": "payload.repository"
        },
        "ORGANIZATION": {
          "$eval": "payload.organization"
        },
        "REPOSITORIES": {
          "$json": {
            "fxci": "fxci-config"
          }
        },
        "FXCI_HEAD_REF": "refs/heads/main",
        "FXCI_HEAD_REPOSITORY": "https://github.com/mozilla-releng/fxci-config",
        "FXCI_REPOSITORY_TYPE": "git"
      },
      "image": "mozillareleases/taskgraph:run-task-v24.1.1@sha256:9b9a1a3ca42025bb8d7eba19e1b8759f04504097265074df25bbc997bd802543",
      "command": [
        "run-task",
        "--fxci-checkout=/builds/worker/checkouts/fxci",
        "--task-cwd=/builds/worker/checkouts/fxci",
        "--",
        "bash",
        "-c",
        "uv run python taskcluster/scripts/redeploy-on-tcyml-change.py --deploy-repo mozilla-releng/fxci-config --deploy-workflow deploy.yml --deploy-ref main --github-app action"
      ],
      "features": {
        "taskclusterProxy": true
      },
      "maxRunTime": 900
    },
    "retries": 3,
    "deadline": {
      "$fromNow": "1 hour"
    },
    "metadata": {
      "name": "taskcluster.yml redeploy",
      "owner": "release+hooks@mozilla.com",
      "source": "https://github.com/mozilla-releng/fxci-config",
      "description": "Redeploy fxci-config when a repository it manages changes its `.taskcluster.yml`"
    },
    "priority": "low",
    "workerType": "build-decision",
    "schedulerId": "releng-level-3",
    "provisionerId": "infra"
  },
  "triggerSchema": {
    "type": "object",
    "required": [
      "organization",
      "repository",
      "ref",
      "eventId"
    ],
    "properties": {
      "ref": {
        "type": "string"
      },
      "eventId": {
        "type": "string"
      },
      "repository": {
        "type": "string"
      },
      "organization": {
        "type": "string"
      }
    },
    "additionalProperties": true
  }
}
